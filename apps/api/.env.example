# ─────────────────────────────────────────────────────────────
# DRSK CBT API — environment variables template.
# Copy to `.env` (gitignored) and fill in real values:
#     Copy-Item .env.example .env
# Validated at startup by src/config/env.schema.ts — the app refuses to
# boot if anything here is missing or invalid.
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
PORT=4000

# --- Database (Neon / PostgreSQL) ---
# Use Neon's DIRECT connection (pooling disabled) — required for migrations.
# Moving to AWS RDS later changes only this line.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Max connections in the pool. node-postgres defaults to 10, which starves when
# a whole batch of candidates starts an exam at the same instant (the platform
# targets 50-200 concurrent). Size against the database's own connection ceiling.
DATABASE_POOL_MAX=25

# --- Logging ---
# One of: fatal error warn info debug trace silent
# Default: debug in development, info in production.
# LOG_LEVEL=debug

# --- Security ---
# Comma-separated allowed CORS origins (e.g. https://app.example.com,https://admin.example.com).
# Empty in dev = allow all; empty in production = block cross-origin requests.
# CORS_ORIGINS=
# Global rate limit per IP: THROTTLE_LIMIT requests per THROTTLE_TTL_MS window.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Login OTP issuance cap per ACCOUNT (spam/cost bound, not the brute-force
# control — guessing is capped per-challenge and by the account lockout).
# Validated by src/config/env.schema.ts; defaults below apply if unset.
# OTP_MAX_PER_WINDOW=30
# OTP_WINDOW_MINUTES=15

# --- Auth (RS256 JWT + stateful sessions) ---
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY: base64-encoded RS256 PEM keys. Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});const b=s=>Buffer.from(s).toString('base64');console.log('JWT_PRIVATE_KEY='+b(privateKey));console.log('JWT_PUBLIC_KEY='+b(publicKey))"
JWT_PRIVATE_KEY=base64-encoded-rs256-private-key-pem
JWT_PUBLIC_KEY=base64-encoded-rs256-public-key-pem
JWT_EXPIRES_IN=1d
INVITE_TTL_HOURS=72
# Base URL of the frontend, used to build the accept-invite link.
FRONTEND_URL=http://localhost:3000

# --- Media storage (§2.7). Optional: the API falls back to local disk. ---
# Set these once the client provisions the bucket (infrastructure is theirs
# per §4/§14). Requires `pnpm add @aws-sdk/client-s3` in apps/api.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
# Optional CDN in front of the bucket; questions reference media by key.
MEDIA_CDN_URL=

# --- Email delivery (§2.6). Optional: invite links and OTP codes log to the
# console until one of the two providers below is configured.
#
# Resend is the PRIMARY transport — a plain REST call, no extra package to
# install. Get an API key from Resend > API Keys, and verify
# RESEND_FROM_EMAIL as a sender/domain in Resend first (Domains).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=Codonmind Nexus

# AWS SES is the SECONDARY transport — used alone if Resend isn't configured,
# or as a live fallback if a Resend send fails. Requires
# `pnpm add @aws-sdk/client-ses` in apps/api, an SES-verified sender identity
# (address or domain), and — to reach recipients who are not themselves
# verified — the SES account moved out of the sandbox. Shares AWS_REGION
# above; make sure it's a region SES is verified in, which may differ from
# where media is stored.
AWS_SES_FROM_EMAIL=
# AWS_SES_FROM_NAME=DRSK CBT

# Inbox the public site's contact form delivers to. Defaults to
# business@codonmind.in if unset.
# CONTACT_EMAIL=business@codonmind.in
