/// Media module (§2.7).
///
/// Images and diagrams used by questions. The FILE lives in object storage
/// (S3 today, via the MediaStoragePort); the database holds only the reference
/// key plus enough metadata to list, validate and serve it. Records are
/// tenant-scoped and follow the same isolation rules as everything else.

/// What a stored file is for. Kept apart because the rules genuinely differ:
/// a question diagram must be an image and small enough to render inline, while
/// a notice attachment is a document nobody renders and may be much larger.
/// Sharing one bucket with one allow-list would mean either rejecting PDFs or
/// offering them in the question picker, where they make no sense.
enum MediaKind {
  IMAGE
  DOCUMENT
}

model Media {
  id          String @id @default(uuid()) @db.Uuid
  instituteId String @map("institute_id") @db.Uuid

  /// Storage key — the only pointer to the bytes. Unique per tenant.
  key      String
  /// Original upload name, shown when picking media.
  fileName String @map("file_name")
  mimeType String @map("mime_type")
  /// IMAGE for question diagrams, DOCUMENT for notice and resource files.
  kind     MediaKind @default(IMAGE)
  /// Bytes, kept so the UI can warn before a large question loads.
  size     Int

  /// Optional caption/alt text — accessibility for diagram-based questions.
  altText String? @map("alt_text")

  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  institute  Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([instituteId, key])
  @@index([instituteId, createdAt])
  @@map("media")
}
