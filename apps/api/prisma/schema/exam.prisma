/// Exam approval lifecycle (§2.3). A teacher authors a DRAFT and submits it to a
/// named admin (REVIEW); that admin approves it into the "qualified" pool
/// (APPROVED); an admin then starts it, which opens the window and makes it
/// PUBLISHED — the only state a candidate can sit. Rejection returns it to DRAFT.
enum ExamStatus {
  DRAFT
  REVIEW
  APPROVED
  /// Returned by an admin with a reason. Editable and re-submittable exactly
  /// like a DRAFT — see QuestionStatus.REJECTED for why it is not one.
  REJECTED
  PUBLISHED
  ARCHIVED
}

/// When results become visible (§2.2). ON_PUBLISH = held until an admin publishes.
enum ResultPolicy {
  IMMEDIATE
  ON_PUBLISH
  BATCH_WISE
}

/// Post-exam grace-marks / remediation handling for a question (§2.5, §2.9).
/// NORMAL = score against the answer key; BONUS = award full marks to everyone;
/// DROPPED = exclude from scoring and from max marks; MANUAL = exclude from
/// auto-scoring and award admin-assigned per-candidate marks (see ManualScore).
enum ExamQuestionScoring {
  NORMAL
  BONUS
  DROPPED
  MANUAL
}

/// Reusable candidate-facing instructions text an admin authors once — "Standard
/// NEET Rules", "JEE Advanced Rules" — that a teacher can drop into an exam's
/// `instructions` while authoring (a one-time copy, not a live link: editing a
/// template afterwards never changes exams that already used it). Tenant-scoped.
model InstructionTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  name        String
  /// HTML, sanitized on write with the same `sanitizeRichText()` boundary as
  /// `Exam.instructions` — authored with the same Tiptap editor.
  content     String
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InstructionTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("instruction_templates")
}

/// A kind of examination an institute runs — "JEE Mock Test", "Physics Practice
/// Test". Administrators define the catalogue; teachers pick one when authoring
/// a paper, and on approval the paper is numbered within its category so
/// candidates see "Physics Practice Test - 2". Tenant-scoped.
model ExamCategory {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  name        String
  description String?
  /// Retired categories stay for the exams that already reference them, but are
  /// no longer offered when authoring a new paper.
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ExamCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  exams     Exam[]
  questions Question[]

  /// One name per tenant, so numbering within a category is unambiguous.
  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("exam_categories")
}

/// An examination (§2.3). Assembled from APPROVED bank questions into sections,
/// assigned to batches, scheduled, then published. Tenant-scoped.
model Exam {
  id                String       @id @default(uuid()) @db.Uuid
  instituteId       String       @map("institute_id") @db.Uuid
  programId         String?      @map("program_id") @db.Uuid
  /// The catalogue entry this paper belongs to. Optional so papers authored
  /// before categories existed keep working.
  categoryId        String?      @map("category_id") @db.Uuid
  /// Sequence within the category, assigned on approval. Null until then —
  /// an unapproved paper has no number because it may never run.
  categorySequence  Int?         @map("category_sequence")
  title             String
  instructions      String?
  durationMinutes   Int          @map("duration_minutes")
  /// Minimum total marks to pass, shown on results. Optional — a paper with no
  /// pass/fail line (e.g. a diagnostic test) simply omits it.
  passingMarks      Int?         @map("passing_marks")
  calculatorEnabled Boolean      @default(false) @map("calculator_enabled")
  /// Proctoring (§2.2 anti-malpractice). The client enforces full screen and
  /// reports violations; `maxViolations` > 0 auto-submits + flags the attempt
  /// once reached (0 = warnings only, no auto-submit).
  fullscreenRequired Boolean     @default(true) @map("fullscreen_required")
  maxViolations      Int         @default(0) @map("max_violations")
  status            ExamStatus   @default(DRAFT)
  resultPolicy      ResultPolicy @default(ON_PUBLISH) @map("result_policy")
  startAt           DateTime?    @map("start_at")
  endAt             DateTime?    @map("end_at")
  createdById       String       @map("created_by_id") @db.Uuid

  /// Approval workflow (§2.3). `reviewerId` is the admin the author assigned to
  /// review it; any admin may action the queue, but the assignment drives whose
  /// queue it lands in. `approvedById` records who actually approved.
  reviewerId      String?   @map("reviewer_id") @db.Uuid
  submittedAt     DateTime? @map("submitted_at")
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  /// Feedback captured when an admin sends an exam back to the author.
  rejectionReason String?   @map("rejection_reason")

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  institute  Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  program    Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  category   ExamCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy  User      @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reviewer   User?     @relation("ExamReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("ExamApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  sections  ExamSection[]
  questions ExamQuestion[]
  batches   ExamBatch[]
  attempts  Attempt[]
  results   Result[]

  @@unique([categoryId, categorySequence])
  @@index([instituteId])
  @@index([instituteId, status])
  @@index([instituteId, categoryId])
  @@map("exams")
}

/// A section within an exam (e.g. Physics), carrying its own marking scheme.
model ExamSection {
  id           String   @id @default(uuid()) @db.Uuid
  examId       String   @map("exam_id") @db.Uuid
  instituteId  String   @map("institute_id") @db.Uuid
  name         String
  order        Int
  marksCorrect Float    @default(4) @map("marks_correct")
  marksWrong   Float    @default(1) @map("marks_wrong")
  createdAt    DateTime @default(now()) @map("created_at")

  exam      Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  institute Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]

  @@unique([examId, order])
  @@index([examId])
  @@index([instituteId])
  @@map("exam_sections")
}

/// Links an APPROVED bank question into an exam section, in order.
model ExamQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  questionId  String              @map("question_id") @db.Uuid
  instituteId String              @map("institute_id") @db.Uuid
  order       Int
  scoring     ExamQuestionScoring @default(NORMAL)
  createdAt   DateTime            @default(now()) @map("created_at")

  exam      Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  section   ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question  Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  institute Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@unique([sectionId, order])
  @@index([examId])
  @@index([sectionId])
  @@index([instituteId])
  @@map("exam_questions")
}

/// Assigns an exam to a batch (many-to-many). Contract §2.3.
model ExamBatch {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([examId, batchId])
  @@index([examId])
  @@index([instituteId])
  @@map("exam_batches")
}
