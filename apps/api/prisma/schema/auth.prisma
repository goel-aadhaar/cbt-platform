/// Platform roles. Creation hierarchy: SUPERADMIN → ADMIN → (TEACHER | STUDENT).
enum Role {
  SUPERADMIN
  ADMIN
  TEACHER
  STUDENT
}

/// PENDING until the invitee accepts the emailed link and sets a password.
enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

/// A platform user account (all roles). Created via invitation by the upper
/// authority (name + email); an emailed link completes registration.
/// Auth details for the linked academic record (Student) live here.
model User {
  id     String     @id @default(uuid()) @db.Uuid
  name   String
  email  String     @unique
  /// Contact number, maintained by the user themselves. Optional: it is not
  /// needed to sit an exam, and the invite flow never collects one.
  phone  String?
  /**
   * Every role this account may act as (§2.2). An array because one person can
   * genuinely be both — a senior teacher who also administers the institute —
   * and forcing them into two accounts means two email addresses and no way to
   * be both at once under the single-session rule.
   *
   * Holding a role is not the same as using it: a session acts as exactly ONE
   * of these at a time (Session.activeRole), so authorization stays least-
   * privilege rather than "whatever this person could be".
   */
  roles  Role[]
  status UserStatus @default(PENDING)

  /// Null until the invitation is accepted and a password is set (argon2 hash).
  passwordHash String? @map("password_hash")

  /// Tenant. NULL for SUPERADMIN (operates above tenants); set for the rest.
  instituteId String? @map("institute_id") @db.Uuid

  /// Who invited this user (creation hierarchy). Null for the seeded superadmin.
  invitedById String? @map("invited_by_id") @db.Uuid

  /// Invitation: hash of the emailed token + its expiry. Cleared on accept.
  invitationTokenHash String?   @map("invitation_token_hash")
  invitationExpiresAt DateTime? @map("invitation_expires_at")

  /// When this user last looked at their announcements, for the unread badge.
  ///
  /// One timestamp rather than a read-per-announcement join table: the badge
  /// only ever needs "how many arrived since you last looked", and a row per
  /// notice per student would grow without ever being read for anything else.
  /// Stored on the user rather than the device so the count agrees across a
  /// phone and a lab machine.
  announcementsSeenAt DateTime? @map("announcements_seen_at")

  /// Single active session (contract §2.2): id of the currently-valid session;
  /// a new login overwrites it, invalidating prior tokens.
  currentSessionId String? @map("current_session_id") @db.Uuid

  /// Brute-force lockout, scoped to the ACCOUNT rather than the caller's IP —
  /// an institute's staff routinely share one office/lab network, so an
  /// IP-keyed limit here would lock out a whole building over one person's
  /// typos (see CandidateThrottlerGuard's own reasoning). Consecutive failed
  /// passwords increment this; a correct one resets it to 0.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Set once failedLoginAttempts crosses the threshold; login is refused
  /// until this passes, even with the correct password.
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  invitedBy User?      @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees  User[]     @relation("UserInvites")
  student   Student?
  sessions  Session[]
  otpChallenges OtpChallenge[]

  questionsCreated  Question[] @relation("QuestionCreatedBy")
  questionsEdited   Question[] @relation("QuestionEditedBy")
  questionsApproved Question[] @relation("QuestionApprovedBy")
  questionsAddedToPractice Question[] @relation("QuestionPracticeAddedBy")
  examsCreated      Exam[]     @relation("ExamCreatedBy")
  examCategoriesCreated ExamCategory[] @relation("ExamCategoryCreatedBy")
  instructionTemplatesCreated InstructionTemplate[] @relation("InstructionTemplateCreatedBy")
  examsToReview     Exam[]     @relation("ExamReviewer")
  examsApproved     Exam[]     @relation("ExamApprovedBy")
  /// Mirror relation for the admin who force-ended a live exam. Distinct from
  /// approvedBy because the same admin could both approve and later pull the
  /// plug on the same exam — both timestamps matter.
  examsForceEnded  Exam[]     @relation("ExamForceEndedBy")
  /// Entry-approval audit mirrors (§ exam entry approval) — the admin who
  /// approved or denied a student's request to enter an exam.
  attemptsApproved Attempt[]  @relation("AttemptApprovedBy")
  attemptsDenied   Attempt[]  @relation("AttemptDeniedBy")
  announcements     Announcement[]
  importRuns        ImportRun[]
  mediaUploaded     Media[]
  teacherBatches    TeacherBatch[]

  @@index([instituteId])
  /// GIN, because staff listings ask "has this role" against an array.
  @@index([roles], type: Gin)
  @@map("users")
  resourcesCreated Resource[] @relation("ResourceAuthor")
}
