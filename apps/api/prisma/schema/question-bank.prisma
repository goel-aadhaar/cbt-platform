/// Question type (contract §2.4). MCQ = single correct; MSQ = multiple correct;
/// INTEGER = numeric answer.
enum QuestionType {
  MCQ
  MSQ
  INTEGER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Lifecycle (§2.5): DRAFT → REVIEW → APPROVED → ARCHIVED. Only APPROVED
/// questions are eligible for exams; ARCHIVED are deactivated (is_active=false).
enum QuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  /// Sent back by an admin. Editable exactly like a DRAFT, but distinct from
  /// one so a teacher can tell "not finished yet" apart from "returned to me",
  /// which are different queues with different urgency. Rejection used to
  /// return the question to DRAFT, where it vanished among the unfinished ones.
  REJECTED
  ARCHIVED
}

/// Subject (e.g. Biology, Physics) — the top level of the question-bank
/// classification hierarchy. Admin-managed; mirrors Program (academic.prisma).
model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  questions Question[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("subjects")
  resources Resource[]
}

/// A chapter within a subject. Admin-managed; mirrors Class (academic.prisma).
model Chapter {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@unique([subjectId, name])
  @@index([instituteId])
  @@index([subjectId])
  @@map("chapters")
}

/// A topic within a chapter — the leaf level, optional on a question. Mirrors
/// Batch (academic.prisma).
model Topic {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  chapterId   String   @map("chapter_id") @db.Uuid
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([chapterId, name])
  @@index([instituteId])
  @@index([chapterId])
  @@map("topics")
}

/// A question in the independent, governed question bank (§2.4). Tenant-scoped;
/// authored by teachers, approved by admins. Exams are later assembled from
/// APPROVED questions.
model Question {
  id          String @id @default(uuid()) @db.Uuid
  instituteId String @map("institute_id") @db.Uuid

  // Tagging / classification (§2.4 — mandatory except topic). `subject`/
  // `chapter`/`topic` are denormalized display+search text kept in sync from
  // subjectId/chapterId/topicId whenever a question is written — the
  // generated `searchVector` column below depends on these three column
  // names directly, so they stay even though the FKs are the source of truth.
  subject    String
  chapter    String
  topic      String?
  subjectId  String       @map("subject_id") @db.Uuid
  chapterId  String       @map("chapter_id") @db.Uuid
  topicId    String?      @map("topic_id") @db.Uuid
  difficulty Difficulty
  type       QuestionType
  language   String       @default("en")
  /// The catalogue entry this question is suited for (§2.3's ExamCategory,
  /// reused rather than inventing a parallel "exam type" taxonomy). Optional
  /// so questions authored before this existed, or with no matching category,
  /// keep working — same tolerance as Exam.categoryId.
  examCategoryId String?  @map("exam_category_id") @db.Uuid
  tags       String[]     @default([])

  // Content (§2.4). options/answerKey are JSON to fit all types:
  //   MCQ  → options [{key,text}], answerKey "A"
  //   MSQ  → options [{key,text}], answerKey ["A","C"]
  //   INTEGER → no options, answerKey 42
  statement     String
  options       Json?
  answerKey     Json     @map("answer_key")
  explanation   String?
  /// PRACTICE ONLY. Exam scoring uses the *section's* marksCorrect/marksWrong
  /// for every question (`ResultsService.evaluate`), because an NTA-style paper
  /// marks per section, not per question. Setting these has no effect on any
  /// exam result — the authoring UI says so.
  marks         Float    @default(4)
  negativeMarks Float    @default(1) @map("negative_marks")
  mediaKeys     String[] @default([]) @map("media_keys")

  /// Full-text search vector (§2.6). DB-generated from statement/subject/
  /// chapter/topic/tags (see migration); queried via raw SQL, opaque to Prisma.
  /// `@default(dbgenerated())` marks it DB-managed so migrate never tries to
  /// alter the GENERATED expression.
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  /// Practice library (§2.4). A teacher curates a SUBSET of APPROVED questions
  /// that students may drill — the library is not the whole bank. No admin
  /// approval is required to add or remove one. A question may sit in the
  /// library AND be used in exams; the exam builder surfaces that overlap.
  inPracticeLibrary Boolean   @default(false) @map("in_practice_library")
  practiceAddedById String?   @map("practice_added_by_id") @db.Uuid
  practiceAddedAt   DateTime? @map("practice_added_at")

  // Lifecycle & edit tracking (§2.5).
  status       QuestionStatus @default(DRAFT)
  isActive     Boolean        @default(true) @map("is_active")
  createdById  String         @map("created_by_id") @db.Uuid
  editedById   String?        @map("edited_by_id") @db.Uuid
  editedAt     DateTime?      @map("edited_at")
  approvedById String?        @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?      @map("approved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  institute  Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  editedBy   User?     @relation("QuestionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  approvedBy      User? @relation("QuestionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  practiceAddedBy User? @relation("QuestionPracticeAddedBy", fields: [practiceAddedById], references: [id], onDelete: SetNull)
  subjectRef      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterRef      Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicRef        Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  examCategory    ExamCategory? @relation(fields: [examCategoryId], references: [id], onDelete: SetNull)
  examQuestions ExamQuestion[]
  responses     Response[]
  practiceAnswers PracticeAnswer[]

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([instituteId, subject])
  @@index([subjectId])
  @@index([chapterId])
  @@index([examCategoryId])
  @@index([instituteId, inPracticeLibrary])
  @@index([searchVector], type: Gin)
  @@map("questions")
}
