/// Root tenant of the platform (contract §2.1). The Institute itself is NOT
/// tenant-scoped — it *is* the tenant.
model Institute {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// URL-safe unique identifier for the tenant (e.g. used in login/routing).
  slug      String   @unique
  /// 4-digit numeric code, assigned once at creation and never changed —
  /// embedded in every student roll number this institute issues
  /// ({yy}{code}{sequence}), so changing it after the fact would silently
  /// desync new roll numbers from every one already handed out.
  code      String   @unique @db.VarChar(4)
  isActive  Boolean  @default(true) @map("is_active")
  /// Storage key of the institute's own logo (§ institute branding), set by
  /// its ADMIN via upload-then-attach — same pattern as a question's
  /// mediaKeys. Null means "no custom logo": every surface falls back to the
  /// platform's default mark, never a broken image.
  logoKey   String?  @map("logo_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  programs      Program[]
  classes       Class[]
  batches       Batch[]
  students      Student[]
  questions     Question[]
  subjects      Subject[]
  chapters      Chapter[]
  topics        Topic[]
  exams         Exam[]
  examCategories ExamCategory[]
  instructionTemplates InstructionTemplate[]
  examSections  ExamSection[]
  examQuestions ExamQuestion[]
  examBatches   ExamBatch[]
  teacherBatches TeacherBatch[]
  attempts         Attempt[]
  practiceSessions PracticeSession[]
  announcements    Announcement[]
  announcementBatches   AnnouncementBatch[]
  announcementTeachers  AnnouncementTeacher[]
  importRuns       ImportRun[]
  media            Media[]
  responses        Response[]
  results          Result[]
  proctoringEvents ProctoringEvent[]
  manualScores     ManualScore[]
  sectionTimes     AttemptSectionTime[]

  @@map("institutes")
  resources        Resource[]
  resourceBatches  ResourceBatch[]
}
