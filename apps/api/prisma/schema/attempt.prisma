enum AttemptStatus {
  /// Student opened the exam and asked to enter; waiting on an admin.
  PENDING_APPROVAL
  /// Admin approved entry; the server timer has NOT started yet — it starts
  /// only when the student calls the begin endpoint from this state.
  APPROVED
  /// Admin declined entry. Not terminal: a denied student may ask again,
  /// which resets the row back to PENDING_APPROVAL for a fresh review.
  DENIED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  /// Left via Logout. The candidate's work is discarded and never evaluated,
  /// but the row remains so the exam cannot be entered a second time.
  ABANDONED
}

/// Proctoring / anti-malpractice signals reported by the exam client (§2.2).
enum ProctoringEventType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  FOCUS_LOSS
  COPY
  PASTE
  OTHER
}

/// NTA-style question-palette states (§2.2).
enum ResponseStatus {
  NOT_VISITED
  NOT_ANSWERED
  ANSWERED
  MARKED
  ANSWERED_MARKED
}

/// A student's attempt at an exam (§2.2). One per student per exam. The server
/// owns the clock: `expiresAt` is computed at begin() from the server's own
/// time, so the timer is refresh/reconnection-safe and auto-submits. How it is
/// computed depends on the exam's kind — a MOCK_TEST gets its full configured
/// duration (its window gates entry only), while an ASSESSMENT gets
/// MIN(duration, window remaining) because it closes itself at its window end
/// with no invigilator to extend it. See attempts.service.ts's begin().
model Attempt {
  id          String        @id @default(uuid()) @db.Uuid
  instituteId String        @map("institute_id") @db.Uuid
  examId      String        @map("exam_id") @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  status      AttemptStatus @default(PENDING_APPROVAL)
  /// Null until `begin()` runs — the server-timer-start moment. Not set at
  /// APPROVED: a student who is approved but never clicks Start Exam must
  /// never be timed out of an attempt whose clock never actually ran.
  startedAt   DateTime?     @map("started_at")
  /// Null until `begin()` computes it (min of start+duration and the exam
  /// window), for the same reason as `startedAt`.
  expiresAt   DateTime?     @map("expires_at")
  submittedAt DateTime?     @map("submitted_at")
  /// Entry-approval audit trail (§ exam entry approval). `approvedAt`/
  /// `approvedById` record the admin who let the student in; `deniedAt`/
  /// `deniedById`/`denialReason` record a decline. A later re-request after a
  /// denial overwrites these rather than accumulating history — the row
  /// tracks the CURRENT decision, not a log.
  approvedAt    DateTime? @map("approved_at")
  approvedById  String?   @map("approved_by_id") @db.Uuid
  deniedAt      DateTime? @map("denied_at")
  deniedById    String?   @map("denied_by_id") @db.Uuid
  denialReason  String?   @map("denial_reason")
  /// Proctoring (§2.2): running count of reported violations; `flagged` is set
  /// when a violation-threshold auto-submit terminates the attempt.
  violationCount Int        @default(0) @map("violation_count")
  flagged        Boolean    @default(false)
  /// Sum of pause-window seconds applied while an admin held this exam in
  /// PAUSED while this attempt was in flight. Each resume adds the new gap
  /// to the cumulative figure; the candidate's `expiresAt` is bumped by the
  /// same amount so the pause does not silently cost them writing time.
  /// NULL — not 0 — for attempts that never experienced a pause, so a
  /// support agent can answer "was this attempt ever paused?" without
  /// rounding zeros.
  pausedForSeconds Int?     @map("paused_for_seconds")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  institute        Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy       User?             @relation("AttemptApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  deniedBy         User?             @relation("AttemptDeniedBy", fields: [deniedById], references: [id], onDelete: SetNull)
  responses        Response[]
  result           Result?
  proctoringEvents ProctoringEvent[]
  manualScores     ManualScore[]
  sectionTimes     AttemptSectionTime[]

  @@unique([examId, studentId])
  @@index([instituteId])
  @@index([studentId])
  @@map("attempts")
}

/// A student's response to one question within an attempt. Auto-saved.
model Response {
  id          String         @id @default(uuid()) @db.Uuid
  attemptId   String         @map("attempt_id") @db.Uuid
  questionId  String         @map("question_id") @db.Uuid
  instituteId String         @map("institute_id") @db.Uuid
  answer      Json?
  status      ResponseStatus @default(NOT_VISITED)
  /// Cumulative time the candidate spent with this question on screen, summed
  /// from client-reported deltas (§2.8 time analysis). Milliseconds rather than
  /// the seconds `AttemptSectionTime` uses: a per-question figure is often only
  /// a few seconds, and "fastest question" needs finer resolution than that.
  /// Null — not 0 — for attempts taken before timing was instrumented, so the
  /// result page can say "not recorded" instead of claiming an instant answer.
  timeSpentMs Int?           @map("time_spent_ms")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  attempt   Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([instituteId])
  @@map("responses")
}

/// A proctoring / anti-malpractice event reported by the exam client during an
/// attempt (§2.2) — e.g. the candidate switched tabs or left full screen.
model ProctoringEvent {
  id          String              @id @default(uuid()) @db.Uuid
  attemptId   String              @map("attempt_id") @db.Uuid
  instituteId String              @map("institute_id") @db.Uuid
  type        ProctoringEventType
  detail      String?
  createdAt   DateTime            @default(now()) @map("created_at")

  attempt   Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([instituteId])
  @@map("proctoring_events")
}

/// Time a candidate spent in each exam section (§2.8 — "time spent per section"
/// in the permanent historical record). The exam client reports elapsed deltas
/// periodically and the server accumulates them; the Result engine folds the
/// totals into each result's per-section breakdown.
model AttemptSectionTime {
  id          String   @id @default(uuid()) @db.Uuid
  attemptId   String   @map("attempt_id") @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  seconds     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attempt   Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
  @@index([attemptId])
  @@index([instituteId])
  @@map("attempt_section_times")
}

/// Admin-assigned marks for a question set to MANUAL evaluation (§2.5), scored
/// per candidate attempt. The Result engine applies these instead of the answer
/// key when the exam question's scoring is MANUAL.
model ManualScore {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  attemptId   String   @map("attempt_id") @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  marks       Float
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attempt   Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([examId])
  @@index([instituteId])
  @@map("manual_scores")
}
