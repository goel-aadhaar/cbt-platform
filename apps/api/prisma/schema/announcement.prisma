/// Updates & Announcements (§2.9).
///
/// Staff-authored notices, read by students AND teachers in their portals.
/// Still deliberately simple: no threading, no per-recipient read receipts —
/// a tenant-scoped notice board that can be aimed at either audience, narrowed
/// to particular batches or particular teachers, and pinned.

enum AnnouncementCategory {
  GENERAL
  EXAM
  RESULT
  SCHEDULE
  MAINTENANCE
}

model Announcement {
  id          String @id @default(uuid()) @db.Uuid
  instituteId String @map("institute_id") @db.Uuid

  title String
  body  String

  category AnnouncementCategory @default(GENERAL)

  /// Who this notice is for. Both may be true — one notice, both audiences.
  /// At least one must be, which the service enforces (a notice addressed to
  /// nobody is a draft nobody asked for, not a valid state).
  ///
  /// Narrowing is expressed by the join rows below, NOT by another flag:
  ///   toStudents + no `batches` rows  = every student in the institute
  ///   toStudents + some `batches`     = only those batches
  ///   toTeachers + no `teachers` rows = every teacher
  ///   toTeachers + some `teachers`    = only those teachers
  ///
  /// "Empty means everyone" reads oddly in isolation but is what keeps the
  /// common case (announce to all) a single boolean rather than requiring the
  /// author to select every batch by hand.
  toStudents Boolean @default(true) @map("to_students")
  toTeachers Boolean @default(false) @map("to_teachers")

  /// Media keys for files attached to this notice (§2.12).
  ///
  /// A plain String[] rather than a relation, matching Question.mediaKeys: the
  /// files live in the media library and are addressed by key, so moving the
  /// bucket or putting a CDN in front never invalidates a notice.
  attachmentKeys String[] @default([]) @map("attachment_keys")

  /// Pinned notices sort above the rest regardless of date.
  pinned Boolean @default(false)

  /// Drafts are invisible to recipients until published.
  publishedAt DateTime? @map("published_at")
  /// Optional auto-expiry; a past date hides it.
  expiresAt   DateTime? @map("expires_at")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  batches  AnnouncementBatch[]
  teachers AnnouncementTeacher[]

  @@index([instituteId, publishedAt])
  @@map("announcements")
}

/// One batch this notice is narrowed to. Same shape as ExamBatch — parent,
/// target, tenant — so a deleted batch takes its targeting rows with it
/// rather than leaving a notice pointing at nothing.
model AnnouncementBatch {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  instituteId    String   @map("institute_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  institute    Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([announcementId, batchId])
  @@index([announcementId])
  @@index([batchId])
  @@map("announcement_batches")
}

/// One teacher this notice is narrowed to. `teacherId` is a User id: a
/// teacher is an account with the TEACHER role, not a separate table the way
/// Student is.
model AnnouncementTeacher {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  instituteId    String   @map("institute_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  teacher      User         @relation("AnnouncementRecipient", fields: [teacherId], references: [id], onDelete: Cascade)
  institute    Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([announcementId, teacherId])
  @@index([announcementId])
  @@index([teacherId])
  @@map("announcement_teachers")
}
