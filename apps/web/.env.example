# Base URL of the DRSK backend API (NestJS). Include the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Default Institute ID prefilled on the student login form. Optional — the
# login form always shows an editable "Institute ID" field; this just
# pre-populates it for single-institute deployments (e.g. "drsk"). If that
# institute's admin changes its Institute ID, update this value too.
NEXT_PUBLIC_DEFAULT_INSTITUTE_SLUG=
