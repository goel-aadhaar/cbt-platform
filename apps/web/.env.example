# Base URL of the DRSK backend API (NestJS). Include the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Default institute code prefilled on the student login form. Optional — the
# login form always shows an editable "Institute Code" field; this just
# pre-populates it for single-institute deployments (e.g. "drsk").
NEXT_PUBLIC_DEFAULT_INSTITUTE_SLUG=

# Staff sign-in with Google (optional). Same OAuth 2.0 Web client ID the API
# verifies against — they must match, or every credential is refused.
# Leave blank to hide the button entirely.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
