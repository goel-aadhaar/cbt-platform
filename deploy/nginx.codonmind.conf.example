# Reverse proxy for codonmind.in — single origin, path-based: /api/* goes to
# the backend, everything else to the frontend. Same routing shape as
# nginx.no-domain.conf.example, but for a real domain with TLS via certbot
# instead of a bare IP over HTTP. This is what deploy/.env.api.production's
# CORS_ORIGINS and deploy/.env.web.production's NEXT_PUBLIC_API_URL assume.
#
#   sudo cp deploy/nginx.codonmind.conf.example /etc/nginx/sites-available/codonmind
#   sudo ln -s /etc/nginx/sites-available/codonmind /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d codonmind.in -d www.codonmind.in
#
# certbot rewrites this file to add the 443/TLS server block and an
# http->https redirect — don't hand-add either yourself first, or certbot's
# edit may not land where you expect.

server {
    listen 80;
    server_name codonmind.in www.codonmind.in;

    # NestJS's own global prefix is /api, so the full original path passes
    # through unchanged — no rewrite needed.
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
